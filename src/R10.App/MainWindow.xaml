<Window x:Class="R10.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:R10.App.Controls" Style="{StaticResource {x:Type Window}}" Title="R10 修改器" Width="1060" Height="860" MinWidth="600" MinHeight="480" WindowStartupLocation="CenterScreen" AutomationProperties.AutomationId="R10.MainWindow" Loaded="WindowLoaded" Closing="WindowClosing" SizeChanged="WindowSizeChanged" PreviewKeyDown="WindowKeyDown">
  <Window.Resources>
    <DataTemplate x:Key="GroupTemplate"><StackPanel Margin="0,0,0,28"><StackPanel Orientation="Horizontal" Margin="0,0,0,8"><TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding Title}" FontWeight="Medium"/></StackPanel><ItemsControl ItemsSource="{Binding Features}"><ItemsControl.ItemTemplate><DataTemplate><controls:FeatureRow/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid x:Name="ApplicationSurface">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SidebarBrush}">
        <Grid Margin="10,22,10,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="8,0,0,32"><Border BorderBrush="{DynamicResource TextBrush}" BorderThickness="1" CornerRadius="8" Width="30" Height="30"><TextBlock Text="R10" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><TextBlock x:Name="BrandLabel" Text="兰斯修改器" FontWeight="Medium" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel>
            <TextBlock x:Name="WorkspaceLabel" Text="工作区" Style="{StaticResource MutedText}" FontSize="11" Margin="12,0,0,7"/>
            <ItemsControl ItemsSource="{Binding Navigation}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource NavigationButton}" Command="{Binding SelectCommand}" ToolTip="{Binding Label}" AutomationProperties.AutomationId="{Binding Key,StringFormat=Navigation.{0}}" AutomationProperties.Name="{Binding Label}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}"/><TextBlock Text="{Binding Label}" Margin="10,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.CompactNavigation, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel>
          <StackPanel Grid.Row="2"><StackPanel x:Name="GameCaption" Margin="9,0,0,16"><TextBlock Text="兰斯 10 · 决战" FontSize="12"/><TextBlock Text="中文 BugFix" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Button Click="ToggleTheme" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" AutomationProperties.AutomationId="ToggleTheme" AutomationProperties.Name="切换明暗主题" ToolTip="切换明暗主题"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE708;" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="ThemeLabel" Text="切换主题" Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Button></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="30,0"><DockPanel LastChildFill="False"><Border DockPanel.Dock="Right" CornerRadius="5" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="7,3" VerticalAlignment="Center"><TextBlock Text="{Binding BuildLabel}" Style="{StaticResource MutedText}" FontSize="11" AutomationProperties.AutomationId="BuildLabel"/></Border><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="R10" Style="{StaticResource MutedText}"/><TextBlock Text="/" Style="{StaticResource MutedText}" Margin="12,0"/><TextBlock Text="{Binding Title}" FontSize="12"/></StackPanel></DockPanel></Border>
        <ScrollViewer x:Name="ContentScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="30,27,30,0" Focusable="False">
          <StackPanel>
            <Grid Margin="0,0,0,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Title}" FontSize="25" FontWeight="Medium"/><StackPanel Grid.Row="1"><TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/><TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionStatus"/></StackPanel></Grid>
            <Border DataContext="{Binding GameSetup}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,20">
              <StackPanel>
                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center"><TextBlock Text="游戏" FontWeight="Medium"/><TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,8,0" AutomationProperties.AutomationId="Game.Summary"/></StackPanel>
                  <Button Grid.Column="1" Content="启动游戏" Style="{StaticResource PrimaryButton}" Command="{Binding LaunchCommand}" Padding="14,6" VerticalAlignment="Center" AutomationProperties.AutomationId="Game.Launch"/>
                </Grid>
                <Expander Style="{StaticResource GameSetupExpander}" IsExpanded="{Binding IsExpanded,Mode=TwoWay}" AutomationProperties.AutomationId="Game.Settings">
                  <Expander.Header><TextBlock Text="{Binding DirectoryLabel}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding DirectoryLabel}" AutomationProperties.AutomationId="Game.Path"/></Expander.Header>
                  <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{StaticResource MutedText}" AutomationProperties.AutomationId="Game.Status"/>
                    <WrapPanel Margin="0,11,0,3">
                      <Button Content="选择游戏" Command="{Binding SelectCommand}" Margin="0,0,7,7" AutomationProperties.AutomationId="Game.Select"/>
                      <Button Content="安装游戏组件" Command="{Binding InstallCommand}" Margin="0,0,7,7" AutomationProperties.AutomationId="Game.Install"/>
                      <Button Content="恢复游戏文件" Command="{Binding RestoreCommand}" Visibility="{Binding ShowRestore,Converter={StaticResource BoolVisibility}}" Margin="0,0,7,7" AutomationProperties.AutomationId="Game.Restore"/>
                      <Button Content="重新检查" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,7" AutomationProperties.AutomationId="Game.Refresh"/>
                    </WrapPanel>
                    <TextBlock Text="安装前请退出游戏。会自动备份当前游戏文件，不修改存档。" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,9,0,0" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="Game.Error" AutomationProperties.LiveSetting="Polite"/>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource SidebarBrush}" CornerRadius="7" Padding="12" Margin="0,0,0,18" Visibility="{Binding ShowNotice,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Notice}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/></Border>
            <Border Background="{DynamicResource SidebarBrush}" CornerRadius="7" Padding="12" Margin="0,0,0,18" Visibility="{Binding ShowError,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap" AutomationProperties.AutomationId="RuntimeError" AutomationProperties.LiveSetting="Polite"/></Border>
            <Grid x:Name="GroupsGrid" IsEnabled="{Binding GameSetup.CanUseFeatures}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="GroupGap" Width="30"/><ColumnDefinition x:Name="RightColumn" Width="*"/></Grid.ColumnDefinitions><StackPanel x:Name="LeftGroups"/><StackPanel x:Name="RightGroups" Grid.Column="2"/></Grid>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="30,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Footer}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" AutomationProperties.AutomationId="OperationStatus" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="KeyboardHint" Grid.Column="1" Text="Enter 应用 · Esc 撤回输入" Style="{StaticResource MutedText}" FontSize="11" Margin="16,0,0,0"/></Grid></Border>
      </Grid>
    </Grid>
    <Border x:Name="ConfirmationOverlay" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed" Padding="25" KeyboardNavigation.TabNavigation="Cycle">
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="26" MaxWidth="400" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel><TextBlock Text="批量修改角色★等级" FontSize="18" FontWeight="Medium"/><TextBlock x:Name="ConfirmationText" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="23"/><TextBlock x:Name="ConfirmationMode" Style="{StaticResource MutedText}" FontSize="11" Margin="0,11,0,0" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,23,0,0"><Button x:Name="CancelConfirmation" Content="取消" Click="CancelStar" MinWidth="68" Padding="12,7" AutomationProperties.AutomationId="Star.Cancel"/><Button Content="确认修改" Click="ConfirmStar" Style="{StaticResource PrimaryButton}" Padding="12,7" Margin="8,0,0,0" AutomationProperties.AutomationId="Star.Confirm"/></StackPanel></StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
